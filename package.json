{
  "name": "es2-testes-web",
  "version": "1.0.0",
  "private": true,
  "description": "Automação de testes web E2E do OrangeHRM demo com Playwright e Page Object",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test tests/login.spec.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://opensource-demo.orangehrmlive.com"
  },
  "dependencies": {
    "@playwright/cli": "^0.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
